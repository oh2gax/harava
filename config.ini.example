; Copy this file to config.ini and change what you need.
[app]
host = 127.0.0.1
port = 5057
; SQLite database file (relative to this folder)
database = harava.db
; Folder that "Scan folder" reads, sub-folders included (relative to this project folder).
; Keep your Fieldwatch exports there; data/ is in .gitignore, so they never go to GitHub.
watch_folder = data
; Open the browser when the app starts
open_browser = true
; A radio heard at least this far apart (metres), in two or more places, is "travelled with me"
travel_min_m = 500

; ── Sign-in ──
; Add the first admin with:  python harava.py --add-admin   (other users on the /maintenance page).
; Users are kept in harava_users.db (not in git). Once a user exists, every page needs a sign-in.
; require_login = true: refuse to start without users. Use it on a server.
require_login = false
; true when Harava runs behind nginx with HTTPS (trusts X-Forwarded-*, cookies over HTTPS only)
behind_proxy = false
; days that "Keep me signed in" lasts
session_days = 30

; ── Imports ──
; Keep a compressed copy of every uploaded export in archive/<user>/ so it can be read again (Re-read)
keep_originals = true

; ── On a server (harava.oh2gax.org) these lines are: ──
; host = 127.0.0.1
; open_browser = false
; require_login = true
; behind_proxy = true
